<%- include('partials/head') %>
<section class="section">
  <div class="container narrow">
    <h1>Chat</h1>

    <div id="joinBox" class="panel join" hidden>
      <label for="usernameInput">Username</label>
      <div class="row">
        <input id="usernameInput" type="text" maxlength="20" placeholder="Contoh: Budi" autocomplete="off">
        <button class="btn" id="joinBtn">Join Chat</button>
      </div>
      <p class="error" id="joinError" role="alert"></p>
    </div>

    <div id="chatBox" class="chat" hidden>
      <div class="chat-main">
        <div class="chat-top"><span>Masuk sebagai <b id="meName"></b></span><button class="btn btn-small btn-ghost" id="leaveBtn" type="button">Keluar</button></div>
        <div class="messages" id="messages" aria-live="polite"></div>
        <form class="chat-form" id="chatForm" autocomplete="off">
          <input id="messageInput" type="text" maxlength="500" placeholder="Tulis pesan...">
          <button class="btn" type="submit">Kirim</button>
        </form>
      </div>
      <aside class="chat-users">
        <h3>Online (<span id="userCount">0</span>)</h3>
        <ul id="userList"></ul>
      </aside>
    </div>
  </div>
</section>
<%- include('partials/foot') %>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/chat.js"></script>
</body></html>
